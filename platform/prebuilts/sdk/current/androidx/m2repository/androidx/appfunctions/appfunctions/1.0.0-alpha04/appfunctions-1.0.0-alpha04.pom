    <url>https://cs.android.com/androidx/platform/frameworks/support</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>androidx.appfunctions</groupId>
        <artifactId>appfunctions-compiler</artifactId>
        <version>1.0.0-alpha04</version>
      </dependency>
      <dependency>
