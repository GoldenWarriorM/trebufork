<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (C) 2026 The trebufork Project
  ~
  ~ Verbatim port of the SystemUI media player styles (styles.xml "MediaPlayer.*"),
  ~ dimensions (qs_media_*) and colors used by the shade/lockscreen media player.
  ~ Referenced ids are renamed with the scrollable_media_ prefix.
  ~
  ~ Fonts: the ROM's Lineage font overlay redefines config_headlineFontFamily to
  ~ "google-sans" and config_headlineFontFamilyMedium to "google-sans-medium"
  ~ (Google Sans Flex instances registered in /product/etc/fonts_customization.xml),
  ~ exactly what the shade player resolves through
  ~ @*android:string/config_headlineFontFamily(Medium) in its layouts. The launcher
  ~ must not override the typeface in code — the XML attribute IS the shade's path.
  -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Styleable for the LightSourceDrawable port (verbatim IlluminationDrawable attrs). -->
    <declare-styleable name="ScrollableMediaLightSource">
        <attr name="rippleMinSize" format="dimension" />
        <attr name="rippleMaxSize" format="dimension" />
    </declare-styleable>

    <style name="ScrollableMediaPlayer" parent="@*android:style/Theme.DeviceDefault.Light">
        <item name="android:textColor">@color/scrollable_media_on_background</item>
    </style>

    <style name="ScrollableMediaPlayer.ProgressBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:thumb">@drawable/scrollable_media_seekbar_thumb</item>
        <item name="android:thumbTint">@color/scrollable_media_on_background</item>
        <item name="android:progressDrawable">@drawable/scrollable_media_squiggly_progress</item>
        <item name="android:progressTint">@color/scrollable_media_on_background</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="ScrollableMediaPlayer.Subtitle">
        <item name="android:textColor">@color/scrollable_media_on_background</item>
    </style>

    <!-- Verbatim MediaPlayer.SessionAction: no static background (the tap effect is
         the MultiRipple overlay above the card, not a per-button drawable), 12dp
         padding, centerInside scaling. -->
    <style name="ScrollableMediaPlayer.SessionAction"
        parent="@android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:tint">@color/scrollable_media_on_background</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- MediaPlayer.SessionAction.Primary: the background is the play/pause container
         AVD (scrollable_media_ic_play/pause_button_container) swapped in code with the
         state and tinted at runtime with primaryFixed (accentPrimary = accent1 t90);
         the icon is tinted at runtime with onPrimaryFixed (accent1 t10). -->
    <style name="ScrollableMediaPlayer.SessionAction.Primary"
        parent="ScrollableMediaPlayer.SessionAction" />

    <style name="ScrollableMediaPlayer.SessionAction.Secondary"
        parent="ScrollableMediaPlayer.SessionAction">
        <item name="android:stateListAnimator">@anim/scrollable_media_button_state_list_animator</item>
    </style>

    <!-- Dimensions: verbatim qs_media_* values from SystemUI dims.xml -->
    <dimen name="scrollable_media_padding">16dp</dimen>
    <dimen name="scrollable_media_action_spacing">4dp</dimen>
    <dimen name="scrollable_media_action_play_pause_width">72dp</dimen>
    <dimen name="scrollable_media_app_icon_size">24dp</dimen>
    <dimen name="scrollable_media_session_height">184dp</dimen>
    <dimen name="scrollable_media_enabled_seekbar_height">2dp</dimen>
    <dimen name="scrollable_media_seekbar_vertical_padding">15dp</dimen>
    <dimen name="scrollable_media_seekbar_progress_wavelength">20dp</dimen>
    <dimen name="scrollable_media_seekbar_progress_amplitude">1.5dp</dimen>
    <dimen name="scrollable_media_seekbar_progress_phase">8dp</dimen>
    <dimen name="scrollable_media_seekbar_progress_stroke_width">2dp</dimen>
    <dimen name="scrollable_media_corner_radius">28dp</dimen>

    <!-- Colors: media_on_background is white; media_seamless_border is a placeholder
         retinted at runtime from the Monet scheme (same as SystemUI). -->
    <color name="scrollable_media_on_background">#FFFFFF</color>
    <color name="scrollable_media_seamless_border">#FFB4AB</color>

</resources>
