<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (C) 2026 The trebufork Project
  ~
  ~ Verbatim port of SystemUI res/drawable/qs_media_scrim.xml: radial gradient from 25%
  ~ black in the center to 100% black at the edges, drawn over the album art. The two
  ~ stops are retinted at runtime from the Monet scheme with the 0.25/1.0 alphas of
  ~ MediaControlViewModel.MEDIA_PLAYER_SCRIM_START/END_ALPHA.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- gradient from 25% in the center to 100% at edges -->
    <gradient
        android:type="radial"
        android:gradientRadius="100%p"
        android:startColor="#40000000"
        android:endColor="#FF000000" />
</shape>
