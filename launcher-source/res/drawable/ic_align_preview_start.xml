        android:fillColor="@android:color/white"
        android:pathData="M4,10.5 a4.5,4.5 0 0 1 4.5,-4.5 h31 a4.5,4.5 0 0 1 4.5,4.5 a4.5,4.5 0 0 1 -4.5,4.5 h-31 a4.5,4.5 0 0 1 -4.5,-4.5 z M4,37.5 a4.5,4.5 0 0 1 4.5,-4.5 h31 a4.5,4.5 0 0 1 4.5,4.5 a4.5,4.5 0 0 1 -4.5,4.5 h-31 a4.5,4.5 0 0 1 -4.5,-4.5 z" />
    <!-- Two icons (diameter 9, centers 11 apart so they never touch), left-aligned -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,24 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 z M15,24 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 z" />
