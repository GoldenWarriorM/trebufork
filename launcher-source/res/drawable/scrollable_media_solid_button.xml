<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (C) 2026 The trebufork Project
  ~
  ~ Port of SystemUI res/drawable/qs_media_solid_button.xml: the pill-shaped solid
  ~ background of the primary (play/pause) action button. The color is applied at runtime
  ~ from the Monet scheme (primaryFixed), like MediaColorSchemes does.
  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@android:color/system_on_primary_dark">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FFFFFFFF" />
            <size android:width="72dp" android:height="48dp" />
        </shape>
    </item>
</ripple>
