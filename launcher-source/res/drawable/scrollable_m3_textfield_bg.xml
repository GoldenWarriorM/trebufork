<!-- trebufork: Material 3 filled text field — a filled rounded container (4dp top corners) with
     an accent underline, mirroring the M3 filled field spec. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp" />
            <solid android:color="@color/materialColorSurfaceContainerHighest" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorAccent" />
        </shape>
    </item>
</layer-list>
