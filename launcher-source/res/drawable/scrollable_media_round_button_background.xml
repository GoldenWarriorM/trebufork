  ~ Verbatim port of SystemUI res/drawable/qs_media_round_button_background.xml: the
  ~ circular pill background of the play/pause button, retinted at runtime with the
  ~ scheme's solid button color (media_player_solid_button_bg).
  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorAccent">
    <item android:id="@android:id/background">
        <shape android:shape="oval">
            <solid android:color="?android:attr/colorAccent" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
</ripple>
