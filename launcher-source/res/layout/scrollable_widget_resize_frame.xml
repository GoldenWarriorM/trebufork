<com.android.launcher3.ScrollableWidgetResizeFrame
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Frame -->
        <ImageView
            android:id="@+id/scroll_widget_resize_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="@dimen/resize_frame_margin"
            android:src="@drawable/widget_resize_frame" />

        <!-- Left -->
        <ImageView
            android:id="@+id/scroll_widget_resize_left_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="@dimen/widget_handle_margin"
            android:src="@drawable/ic_widget_resize_handle"
            android:tint="?attr/workspaceAccentColor" />

        <!-- Top -->
        <ImageView
            android:id="@+id/scroll_widget_resize_top_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/widget_handle_margin"
            android:src="@drawable/ic_widget_resize_handle"
            android:tint="?attr/workspaceAccentColor" />

        <!-- Right -->
        <ImageView
            android:id="@+id/scroll_widget_resize_right_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="@dimen/widget_handle_margin"
            android:src="@drawable/ic_widget_resize_handle"
            android:tint="?attr/workspaceAccentColor" />

        <!-- Bottom -->
        <ImageView
            android:id="@+id/scroll_widget_resize_bottom_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/widget_handle_margin"
            android:src="@drawable/ic_widget_resize_handle"
            android:tint="?attr/workspaceAccentColor" />

    </FrameLayout>
</com.android.launcher3.ScrollableWidgetResizeFrame>
