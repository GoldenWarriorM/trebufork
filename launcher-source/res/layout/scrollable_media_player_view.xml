<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (C) 2026 The trebufork Project
  ~
  ~ Verbatim adaptation of the SystemUI media player layout
  ~ (packages/SystemUI/res/layout/media_session_view.xml) with the expanded-state
  ~ constraints from res/xml/media_session_expanded.xml inlined: the play/pause pill sits
  ~ above the bottom action row, and the bottom row is prev | seekbar | next | custom
  ~ actions spread across the card, exactly like the shade player.
  -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollable_media_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal|fill_vertical"
    android:forceHasOverlappingRendering="false"
    android:background="@drawable/scrollable_media_outline_layout_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/scrollable_media_album_art"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrollable_media_session_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:translationZ="0dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:clipToOutline="true"
        android:background="@drawable/scrollable_media_outline_album_bg"
        />

    <!-- Tap ripple overlay (MultiRippleView in the shade player): the circle expands
         from the pressed action button across the whole card and is clipped to it. -->
    <com.android.launcher3.ScrollableMediaRippleView
        android:id="@+id/scrollable_media_touch_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToOutline="true"
        android:background="@drawable/scrollable_media_outline_layout_bg" />

    <!-- App icon -->
    <com.android.internal.widget.CachingIconView
        android:id="@+id/scrollable_media_icon"
        android:layout_width="@dimen/scrollable_media_app_icon_size"
        android:layout_height="@dimen/scrollable_media_app_icon_size"
        android:layout_marginStart="@dimen/scrollable_media_padding"
        android:layout_marginTop="@dimen/scrollable_media_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Song name -->
    <TextView
        android:id="@+id/scrollable_media_header_title"
        android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="@color/scrollable_media_on_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/scrollable_media_padding"
        android:layout_marginEnd="@dimen/scrollable_media_padding"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scrollable_media_actionPlayPause"
        app:layout_constraintBottom_toTopOf="@+id/scrollable_media_header_artist"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Artist name -->
    <TextView
        android:id="@+id/scrollable_media_header_artist"
        android:fontFamily="@*android:string/config_headlineFontFamily"
        android:singleLine="true"
        android:textSize="14sp"
        android:textColor="@color/scrollable_media_on_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/scrollable_media_padding"
        android:layout_marginEnd="@dimen/scrollable_media_padding"
        android:layout_marginBottom="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/scrollable_media_actionPlayPause"
        app:layout_constraintBottom_toTopOf="@+id/scrollable_media_actionPrev"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Play/pause sits above the bottom action row, right-aligned (expanded state).
         72x48dp like the shade: qs_media_action_play_pause_width x 48dp; the background
         is the 88x56dp container AVD scaled down into the 72x48dp frame. -->
    <ImageButton
        android:id="@+id/scrollable_media_actionPlayPause"
        style="@style/ScrollableMediaPlayer.SessionAction.Primary"
        android:layout_width="@dimen/scrollable_media_action_play_pause_width"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/scrollable_media_padding"
        android:layout_marginEnd="@dimen/scrollable_media_padding"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/scrollable_media_actionNext" />

    <ImageButton
        android:id="@+id/scrollable_media_actionPrev"
        style="@style/ScrollableMediaPlayer.SessionAction.Secondary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Seek Bar: forced to LTR in code, as per Material Design on Bidirectionality.
         Padding 15dp top / 12dp bottom centers the 2dp track in the 48dp view, exactly
         like the shade's qs_media_session_enabled_seekbar_vertical_padding + 12dp. -->
    <SeekBar
        android:id="@+id/scrollable_media_progress_bar"
        style="@style/ScrollableMediaPlayer.ProgressBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:paddingTop="@dimen/scrollable_media_seekbar_vertical_padding"
        android:paddingBottom="12dp"
        android:maxHeight="@dimen/scrollable_media_enabled_seekbar_height"
        android:splitTrack="false"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintStart_toEndOf="@id/scrollable_media_actionPrev"
        app:layout_constraintEnd_toStartOf="@+id/scrollable_media_actionNext"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <ImageButton
        android:id="@+id/scrollable_media_actionNext"
        style="@style/ScrollableMediaPlayer.SessionAction.Secondary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="@dimen/scrollable_media_action_spacing"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintEnd_toStartOf="@+id/scrollable_media_action0"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Custom session actions (heart / shuffle etc.), visibility controlled in code.
         SystemUI binds only two custom actions into the bottom row (action0, action1) —
         anything beyond is paginated, so the row never overcrowds the seekbar. -->
    <ImageButton
        android:id="@+id/scrollable_media_action0"
        style="@style/ScrollableMediaPlayer.SessionAction.Secondary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/scrollable_media_action_spacing"
        android:layout_marginEnd="@dimen/scrollable_media_action_spacing"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/scrollable_media_action1"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/scrollable_media_action1"
        style="@style/ScrollableMediaPlayer.SessionAction.Secondary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/scrollable_media_action_spacing"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Carousel page indicator (SystemUI media_page_indicator): animated dots shown
         only when more than one player is active; overlaid at the card's bottom edge
         (must stay INSIDE the card bounds, which clip their outline). -->
    <com.android.launcher3.ScrollableMediaPageIndicator
        android:id="@+id/scrollable_media_page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
