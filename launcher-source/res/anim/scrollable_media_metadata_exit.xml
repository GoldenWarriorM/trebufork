<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (C) 2026 The trebufork Project
  ~
  ~ Verbatim port of SystemUI res/anim/media_metadata_exit.xml: old song title/artist
  ~ slide out to the left (0 -> -32dp over 167ms, accelerate) while fading out with an
  ~ 83ms offset. SystemUI's private EMPHASIZED_ACCELERATE interpolator is replaced with
  ~ the closest public framework curve, applied in code like loadAnimator does.
  -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
     android:ordering="together">
    <objectAnimator
        android:propertyName="translationX"
        android:valueFrom="0dp"
        android:valueTo="-32dp"
        android:duration="167"
        android:valueType="floatType"
        android:interpolator="@android:interpolator/accelerate_quad" />
    <objectAnimator
        android:propertyName="alpha"
        android:valueFrom="1"
        android:valueTo="0"
        android:duration="83"
        android:startOffset="83"
        android:valueType="floatType" />
</set>
