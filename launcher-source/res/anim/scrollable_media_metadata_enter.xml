<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (C) 2026 The trebufork Project
  ~
  ~ Verbatim port of SystemUI res/anim/media_metadata_enter.xml: new song title/artist
  ~ slide in from the right (32dp -> 0 over 600ms) while fading in (167ms). SystemUI's
  ~ private EMPHASIZED_DECELERATE interpolator is replaced with the closest public
  ~ framework curve (as in scrollable_media_button_state_list_animator.xml), applied in
  ~ code to the translationX child like MediaControlPanel.loadAnimator does.
  -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
     android:ordering="together">
    <objectAnimator
        android:propertyName="translationX"
        android:valueFrom="32dp"
        android:valueTo="0dp"
        android:duration="600"
        android:valueType="floatType" />
    <objectAnimator
        android:propertyName="alpha"
        android:valueFrom="0"
        android:valueTo="1"
        android:duration="167"
        android:valueType="floatType" />
</set>
